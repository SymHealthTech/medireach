# ─────────────────────────────────────────────────────────────────────────────
# MediReach environment variables.
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# Every key here is read server-side only (spec §15.3) unless prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
# Public base URL of the app (used for share links, webhooks, OTP messages).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Public website contact (spec §4) ---
# WhatsApp number in international format without '+' (e.g. 9198XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=919800000000
NEXT_PUBLIC_SUPPORT_EMAIL=support@medireach.app

# --- Database (MongoDB Atlas — Flex tier, spec §14) ---
MONGODB_URI=mongodb://localhost:27017/medireach

# --- Auth / sessions (spec §15.1) ---
# 32+ byte random secret for signing session JWTs. Generate: openssl rand -base64 48
AUTH_SESSION_SECRET=replace-with-long-random-secret
# Separate secret for the trusted-device token (new-device OTP model, spec §15.1).
AUTH_DEVICE_SECRET=replace-with-another-long-random-secret
# Obscure, hard-to-guess admin route segment (spec §6.7). No leading slash.
ADMIN_ROUTE_SECRET=change-this-obscure-admin-path
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=replace-with-long-random-cron-secret

# --- Cloudinary (signed/private delivery only, spec §15.3) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Anthropic / Claude (transcript structuring, spec §7.3) ---
ANTHROPIC_API_KEY=

# --- Speech-to-text (spec §14) ---
# Provider: "openai" (default) uses Whisper via SPEECH_TO_TEXT_API_KEY.
#           "google" uses Google Cloud Speech-to-Text via a service account key.
SPEECH_TO_TEXT_PROVIDER=openai
SPEECH_TO_TEXT_API_KEY=
# Path to a Google Cloud service account JSON key file (only needed when
# SPEECH_TO_TEXT_PROVIDER=google). Relative paths are resolved from the
# project root. This file must NEVER be committed — it is in .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Email (Resend) — OTP delivery (signup verify, new device, password reset)
#     and transactional mail. Email is the ONLY OTP/recovery channel (no SMS).
RESEND_API_KEY=
# Must be a verified sender/domain in Resend; the resend.dev address works for testing.
RESEND_FROM=MediReach <onboarding@resend.dev>

# --- Razorpay (billing + payment links + webhooks, spec §11/§15.3) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Push notifications (Web Push) — the SOLE channel for SOS alerts AND
#     billing notifications. No SMS provider is used anywhere. (spec §10/§14) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@medireach.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
