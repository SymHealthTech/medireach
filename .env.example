# ─────────────────────────────────────────────────────────────────────────────
# MediReach portfolio — environment variables.
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# Every key here is read server-side only unless prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
# Public base URL of the portfolio site (canonical URLs, sitemap, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Public website contact ---
# WhatsApp number in international format without '+' (e.g. 9198XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=919800000000
NEXT_PUBLIC_SUPPORT_EMAIL=support@medireach.co.in

# --- Database (MongoDB Atlas) ---
# The cluster may be shared with the clinic software (separate repo,
# medireach-clinic); the database is selected by MONGODB_DB (default
# medireach_portfolio). Never set it to "medireach" — that is the clinic's database.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=medireach_portfolio

# --- Auth / sessions ---
# 32+ byte random secret for signing session JWTs. Generate: openssl rand -base64 48
AUTH_SESSION_SECRET=replace-with-long-random-secret
# First superadmin, created by `npm run seed:admin` (password: 12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Doctor login (NextAuth email magic link). NEXTAUTH_SECRET defaults to
# AUTH_SESSION_SECRET; NEXTAUTH_URL defaults to NEXT_PUBLIC_SITE_URL.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) — lead notifications + doctor login links. No SMS. ---
RESEND_API_KEY=
# Must be a verified sender/domain in Resend; the resend.dev address works for testing.
RESEND_FROM=MediReach <onboarding@resend.dev>
# Where new website leads and doctors' change requests are emailed (defaults to ADMIN_EMAIL).
LEAD_NOTIFY_EMAIL=
# Daily renewal digest (reminders sent, sites paused). Defaults to LEAD_NOTIFY_EMAIL, then ADMIN_EMAIL.
RENEWAL_NOTIFY_EMAIL=

# --- Cron (Vercel) ---
# Vercel sends this as a Bearer token to /api/cron/renewals (vercel.json). Any long random string.
CRON_SECRET=

# --- SEO ---
GOOGLE_SITE_VERIFICATION=
