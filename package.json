{
  "name": "medireach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:masters": "node --env-file-if-exists=.env.local --import tsx scripts/seed-masters.ts",
    "seed:samples": "node --env-file-if-exists=.env.local --import tsx scripts/seed-samples.ts",
    "seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "backfill:uids": "node --env-file-if-exists=.env.local --import tsx scripts/backfill-uids.ts",
    "seed:admin": "node --env-file-if-exists=.env.local --import tsx scripts/seed-admin.ts",
    "migrate:v2": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-v2.ts",
    "renewals": "node --env-file-if-exists=.env.local --require ./scripts/no-server-only.cjs --import tsx scripts/renewals.ts"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "mongoose": "^8.8.3",
    "motion": "^14.14.0",
    "next": "^15.3.4",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.2.5",
    "resend": "^4.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "1.9",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.4",
    "mongodb-memory-server": "^10.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
